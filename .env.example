VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your_project.supabase.co
# GIPHY_API_KEY and ANTHROPIC_API_KEY are NOT Vite env vars - they're read
# server-side by the giphy-proxy and build-it Supabase edge functions.
# Set them as Supabase/Lovable secrets.
